{
	"name": "PL_CDC",
	"properties": {
		"activities": [
			{
				"name": "CopyCDCChangesToBlob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "If Watermark Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "SELECT \n    '@{pipeline().parameters.DatabaseName}' as SOURCE_DATABASE,\n    CONVERT(VARCHAR(50), __$start_lsn, 1) as SOURCE_LSN,\n    CASE __$operation\n        WHEN 1 THEN 'DELETE'\n        WHEN 2 THEN 'INSERT'\n        WHEN 3 THEN 'UPDATE_BEFORE'\n        WHEN 4 THEN 'UPDATE_AFTER'\n        ELSE 'UNKNOWN'\n    END as CDC_OPERATION,\n    ISNULL(CM03_CUST, '') as CM03_CUST,\n    ISNULL(CM03_NAME, '') as CM03_NAME,\n    ISNULL(CM03_CUSTTYPE, '') as CM03_CUSTTYPE,\n    ISNULL(CM03_ADD1, '') as CM03_ADD1,\n    ISNULL(CM03_CITY, '') as CM03_CITY,\n    ISNULL(CM03_STAT, '') as CM03_STAT,\n    ISNULL(CM03_PZIP, '') as CM03_PZIP,\n    ISNULL(CM03_PHON, '') as CM03_PHON\nFROM @{pipeline().parameters.CDCSchemaName}.@{pipeline().parameters.CDCTableName}\nWHERE __$start_lsn > CONVERT(binary(10), '@{variables('CurrentLSN')}', 1)\nORDER BY __$start_lsn",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "arrayOfObjects"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_CDC_Source",
						"type": "DatasetReference",
						"parameters": {
							"TableName": {
								"value": "@pipeline().parameters.CDCTableName",
								"type": "Expression"
							},
							"TableSchema": {
								"value": "@pipeline().parameters.CDCSchemaName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Blob_CDC_JSON",
						"type": "DatasetReference",
						"parameters": {
							"DatabaseName": "@pipeline().parameters.DatabaseName"
						}
					}
				]
			},
			{
				"name": "GetWatermark",
				"type": "Lookup",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_Blob_Watermark",
						"type": "DatasetReference",
						"parameters": {
							"DatabaseName": "@pipeline().parameters.DatabaseName"
						}
					}
				}
			},
			{
				"name": "SetLSN_FromWatermark",
				"type": "SetVariable",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "GetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "CurrentLSN",
					"value": "@activity('GetWatermark').output.firstRow.last_lsn"
				}
			},
			{
				"name": "CheckWatermarkExists",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Blob_Watermark",
						"type": "DatasetReference",
						"parameters": {
							"DatabaseName": "@pipeline().parameters.DatabaseName"
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "If Watermark Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CheckWatermarkExists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('CheckWatermarkExists').output.exists",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "GetWatermark_copy1",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"dataset": {
									"referenceName": "DS_Blob_Watermark",
									"type": "DatasetReference",
									"parameters": {
										"DatabaseName": "@pipeline().parameters.DatabaseName"
									}
								}
							}
						},
						{
							"name": "SetLSN_FromWatermark_copy1",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetWatermark_copy1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "CurrentLSN",
								"value": "@activity('GetWatermark').output.firstRow.last_lsn"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"DatabaseName": {
				"type": "string",
				"defaultValue": "TRUX_MN_COMP"
			},
			"CDCTableName": {
				"type": "string",
				"defaultValue": "dbo_CM03_CT"
			},
			"LastProcessedLSN": {
				"type": "string",
				"defaultValue": "0x00000000000000000000"
			},
			"CDCSchemaName": {
				"type": "string",
				"defaultValue": "cdc"
			}
		},
		"variables": {
			"CurrentLSN": {
				"type": "String",
				"defaultValue": "0x00000000000000000000"
			}
		},
		"folder": {
			"name": "Test"
		},
		"annotations": []
	}
}